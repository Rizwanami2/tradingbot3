[Unit]
Description=Institutional Gold and Bitcoin Quantitative Trading Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tradingbot3
ExecStart=/home/ubuntu/tradingbot3/venv/bin/python3 /home/ubuntu/tradingbot3/telegram_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
