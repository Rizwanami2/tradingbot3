# ==========================================
# Bottreding Telegram & MT5 Bot Configuration
# Copy this file to '.env' and fill in your values
# ==========================================

# Trading Mode: paper | demo | live (Default is strictly paper for safety)
TRADING_MODE=paper

# Live Mode Confirmation Guard: Must be set to 'CONFIRM' if TRADING_MODE=live
LIVE_CONFIRM=

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Allowed Telegram Chat IDs (comma-separated or JSON list, e.g. [12345678, 87654321])
ALLOWED_TELEGRAM_IDS=[]

# Primary numeric Telegram Chat ID (optional; bot auto-detects on /start if left empty)
TELEGRAM_CHAT_ID=12345

# ==========================================
# MetaTrader 5 (MT5) Live Broker Credentials
# ==========================================
# (Optional) Provide login credentials or leave blank if MT5 terminal is already running logged-in on your VPS desktop
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# MetaTrader 5 Symbols
MT5_BTC_SYMBOL=BTCUSD
MT5_GOLD_SYMBOL=XAUUSD

# ==========================================
# Institutional Risk Management & Safety Gates
# ==========================================
# Account Balance in USD (used to calculate exact lot sizes in paper mode)
ACCOUNT_BALANCE=10000

# Risk % per trade (Strict institutional default: 1.0% for A+ setups, 0.5% for B setups)
RISK_PCT_PER_TRADE=1.0

# Circuit Breaker: Daily Drawdown Kill-Switch (% loss from daily starting equity to halt all entries)
MAX_DAILY_LOSS_PCT=1.5

# Portfolio Risk Cap: Max combined open risk across all positions (in %)
MAX_TOTAL_OPEN_RISK_PCT=2.5

# Pre-Order Spread Guard: Max allowed spread in pips (orders skipped if spread exceeds this)
MAX_SPREAD_PIPS=30

# Post-Order Slippage Guard: Max allowed fill slippage in pips before warning/alert
MAX_SLIPPAGE_PIPS=3

# Circuit Breaker: Max Cumulative Drawdown Limit (% loss from peak to halt portfolio)
MAX_TOTAL_DRAWDOWN_PCT=6.0

# Minimum Confluence Score to alert (8-10)
MIN_CONFLUENCE_SCORE=8

# ==========================================
# Automated Execution & Advanced Safety Gates
# ==========================================
# Limit Orders in Zones (Golden Pocket / Resistance)
LIMIT_ORDERS_ENABLED=true
LIMIT_ORDER_OFFSET_PIPS=2
LIMIT_ORDER_EXPIRY_MIN=35

# High-Impact Macro News Avoidance
NEWS_AVOIDANCE_ENABLED=true
NEWS_BLOCK_BEFORE_MIN=15
NEWS_BLOCK_AFTER_MIN=30

# Regime-Conditioned Dynamic Risk Sizing (%)
TRADE_RISK_TREND=0.8
TRADE_RISK_CHOP=0.5
TRADE_RISK_SHOCK=0.35

# Automated Partial Take-Profit, Breakeven & Trailing Stop
PARTIAL_TP_PCT=50
BE_TRIGGER_R=0.6
TRAIL_TRIGGER_R=1.0
ATR_TRAIL_MULT=1.0

# Predictive Entry Zones (Telegram /predict_gold | /predict_btc)
PREDICTIVE_ZONE_TTL_SECONDS=300

# Trading Cost per 0.01 lot (commission + spread round-trip, in USD)
TRADE_COST_PER_01_LOT=0.25