# ==========================================
# tradingbot3 - Configuration Template
# ==========================================
# IMPORTANT: Copy this file to '.env' and fill in your values.
# NEVER commit your real .env file to git.
# ==========================================

# --------------------------------------------------
# TRADING MODE (CRITICAL SAFETY SETTING)
# --------------------------------------------------
# Allowed values: paper | demo | live
# ALWAYS start with 'paper'. Only change to 'live' after thorough testing.
TRADING_MODE=paper

# Live Mode Confirmation Guard
# Must be exactly 'CONFIRM' if TRADING_MODE=live
# Leave empty for paper/demo mode.
LIVE_CONFIRM=

# --------------------------------------------------
# TELEGRAM
# --------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Allowed Telegram Chat IDs (comma-separated or JSON list)
# Example: 123456789,987654321  or  [123456789,987654321]
ALLOWED_TELEGRAM_IDS=[]

# Primary numeric Telegram Chat ID (optional)
TELEGRAM_CHAT_ID=

# --------------------------------------------------
# METATRADER 5 (MT5)
# --------------------------------------------------
# Leave blank if MT5 terminal is already logged in on the machine.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

MT5_BTC_SYMBOL=BTCUSD
MT5_GOLD_SYMBOL=XAUUSD

# --------------------------------------------------
# RISK MANAGEMENT (Start Conservative)
# --------------------------------------------------
ACCOUNT_BALANCE=10000

# Risk % per trade (Recommended starting: 0.5 - 0.75)
RISK_PCT_PER_TRADE=0.75

# Daily loss circuit breaker (%)
MAX_DAILY_LOSS_PCT=1.5

# Max combined open risk across all positions (%)
MAX_TOTAL_OPEN_RISK_PCT=3.0

# Max allowed spread (pips)
MAX_SPREAD_PIPS=30
MAX_SPREAD_BTC_PIPS=40

# Max allowed slippage (pips)
MAX_SLIPPAGE_PIPS=3

# Max total drawdown from peak (%)
MAX_TOTAL_DRAWDOWN_PCT=6.0

# Minimum confluence score to take a trade (8-10 recommended)
MIN_CONFLUENCE_SCORE=8.5

# --------------------------------------------------
# AUTOMATION & ADVANCED SETTINGS
# --------------------------------------------------
LIMIT_ORDERS_ENABLED=true
LIMIT_ORDER_OFFSET_PIPS=2
LIMIT_ORDER_EXPIRY_MIN=35

NEWS_AVOIDANCE_ENABLED=true
NEWS_BLOCK_BEFORE_MIN=15
NEWS_BLOCK_AFTER_MIN=30

# Regime-based risk multipliers
TRADE_RISK_TREND=0.8
TRADE_RISK_CHOP=0.5
TRADE_RISK_SHOCK=0.35

# Trade management
PARTIAL_TP_PCT=50
BE_TRIGGER_R=0.6
TRAIL_TRIGGER_R=1.0
ATR_TRAIL_MULT=1.0
