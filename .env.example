# ==========================================
# Bottreding Telegram & MT5 Bot Configuration
# Copy this file to '.env' and fill in your values
# ==========================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your numeric Telegram Chat ID (optional; bot auto-detects on /start if left empty)
TELEGRAM_CHAT_ID=

# MetaTrader 5 Symbols
MT5_BTC_SYMBOL=BTCUSD
MT5_GOLD_SYMBOL=XAUUSD

# ==========================================
# Risk Management & Position Sizing
# ==========================================
# Account Balance in USD (used to calculate exact lot sizes)
ACCOUNT_BALANCE=10000

# Risk % per trade (Strict institutional default: 1.0% for A+ setups, 0.5% for B setups)
RISK_PCT_PER_TRADE=1.0

# Circuit Breaker: Daily Drawdown Limit (% loss from daily open to halt new trades)
MAX_DAILY_DRAWDOWN_PCT=2.0

# Circuit Breaker: Max Cumulative Drawdown Limit (% loss from peak to halt portfolio)
MAX_TOTAL_DRAWDOWN_PCT=6.0

# Minimum Confluence Score to alert (8-10)
MIN_CONFLUENCE_SCORE=8
